# =============================================================
#  MUHIT O'ZGARUVCHILARI NAMUNASI
#  Nusxa oling:  cp .env.example .env
#  So'ng qiymatlarni to'ldiring. .env faylini HECH QACHON git'ga qo'shmang.
# =============================================================

# ---- Umumiy ----
NODE_ENV=development
# Telegram bot tokeni (@BotFather -> /newbot). MAXFIY! Kodga yozilmaydi.
BOT_TOKEN=
# SQLite ma'lumotlar bazasi fayli
DB_PATH=storage/db/shop.sqlite
# debug | info | warn | error
LOG_LEVEL=info
# Kunlik log fayllari necha kun saqlanadi (disk to'lib ketmasligi uchun)
LOG_RETENTION_DAYS=14
# Do'kon valyutasi (faqat ko'rsatish uchun)
CURRENCY=so'm

# ---- Admin web panel ----
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3000
# Serverga joylashtirilganda ommaviy manzil (bot xabarlaridagi havolalar uchun)
ADMIN_PUBLIC_URL=
# Admin sessiyasi necha soat amal qiladi
ADMIN_SESSION_HOURS=12
# Noto'g'ri parol kiritish limiti (15 daqiqada)
ADMIN_LOGIN_ATTEMPTS=5

# ---- Boshlang'ich administrator (faqat birinchi `npm run seed` uchun) ----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin12345!
# Admin Telegram ID (buyurtma xabarlarini olish uchun). Bo'sh qoldirilsa,
# botda `/adminim <username> <parol>` buyrug'i bilan o'zingizni ulaysiz.
SEED_ADMIN_TELEGRAM_ID=

# ---- Zaxira nusxa (npm run backup — har kuni cron orqali) ----
# Saqlanadigan nusxalar soni
BACKUP_KEEP=14
# Nusxalar papkasi (bo'sh bo'lsa: storage/backups)
BACKUP_DIR=

# ---- Feature flag'lar (kelajakdagi funksiyalar; 1 = yoqilgan) ----
FEATURE_PROMOCODES=0
FEATURE_BONUSES=0
FEATURE_CASHBACK=0
FEATURE_COMPARE=0
FEATURE_REVIEWS=0
FEATURE_COURIER=0
FEATURE_SMS=0
FEATURE_MARKETING=0
FEATURE_CRM=0
FEATURE_ONLINE_PAYMENTS=0

# ---- Ixtiyoriy: to'lov provayderlari (hozircha o'chiq) ----
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=
