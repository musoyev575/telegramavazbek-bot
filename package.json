{
  "name": "telefon-store-bot",
  "version": "1.0.0",
  "description": "Telefon sotuv magazini uchun Telegram bot + admin web panel (O'zbek tilida)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "bot": "node src/index.js --bot-only",
